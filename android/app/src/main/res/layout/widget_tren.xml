<?xml version="1.0" encoding="utf-8"?>
<!-- Widget del próximo tren (RemoteViews: solo vistas permitidas). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fondo"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_trayecto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/tinta"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/w_refrescar"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="Actualizar"
            android:padding="4dp"
            android:src="@drawable/ic_refrescar" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="true"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_hora"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/tinta"
            android:textSize="30sp"
            android:textStyle="bold" />

        <Chronometer
            android:id="@+id/w_cuenta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="monospace"
            android:textColor="@color/tinta"
            android:textSize="20sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/w_faltan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textColor="@color/tinta"
            android:textSize="18sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_siguiente"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/tinta"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/w_estado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:textColor="@color/tinta_suave"
        android:textSize="11sp" />
</LinearLayout>
