<?xml version="1.0" encoding="utf-8"?>
<!-- Widget del próximo tren (RemoteViews: solo vistas permitidas).
     Cabecera con logo y trayecto, cuenta regresiva grande, hora de salida y el
     siguiente tren en una pastilla. Según el alto (WidgetTren.tamano) se ocultan
     la pastilla, el estado y la cabecera; la cuenta regresiva siempre queda. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fondo"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="10dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:id="@+id/w_cabecera"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="@null"
            android:src="@drawable/logo_trenar" />

        <TextView
            android:id="@+id/w_trayecto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="TrenAR"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/w_invertir"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="Invertir ida y vuelta"
            android:padding="6dp"
            android:src="@drawable/ic_invertir"
            android:tint="#E6FFFFFF" />

        <ImageView
            android:id="@+id/w_proximo"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="Siguiente favorito"
            android:padding="6dp"
            android:src="@drawable/ic_siguiente"
            android:tint="#E6FFFFFF" />

        <ImageView
            android:id="@+id/w_refrescar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="Actualizar"
            android:padding="7dp"
            android:src="@drawable/ic_refrescar"
            android:tint="#E6FFFFFF" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- La cuenta ocupa el alto libre y achica la letra para entrar (API 26+). -->
        <Chronometer
            android:id="@+id/w_cuenta"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="40sp"
            android:autoSizeMinTextSize="14sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="sans-serif-condensed"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#FFFFFFFF"
            android:textSize="34sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/w_faltan"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="32sp"
            android:autoSizeMinTextSize="14sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="sans-serif-condensed"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#FFFFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/w_hora"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#CCFFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_siguiente"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        android:background="@drawable/widget_pastilla"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingStart="10dp"
        android:paddingTop="4dp"
        android:paddingEnd="10dp"
        android:paddingBottom="4dp"
        android:text="Tocá para elegir un viaje"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/w_estado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#99FFFFFF"
        android:textSize="11sp" />
</LinearLayout>
